{{- if and (eq .chezmoi.os "linux") (has .chezmoi.osRelease.id (list "fedora" "rhel" "centos" "rocky" "almalinux" "ol")) -}}
#!/bin/sh
set -eu

{{ if ne .chezmoi.osRelease.id "fedora" -}}
# Everything but git/jq/zsh lives in EPEL on the RHEL rebuilds, and several
# EPEL packages need CRB. The repo names differ per rebuild and RHEL proper
# uses a subscription-manager name, so a failure here is not fatal.
sudo dnf install -y dnf-plugins-core
rpm -q epel-release >/dev/null 2>&1 || \
  sudo dnf install -y "https://dl.fedoraproject.org/pub/epel/epel-release-latest-$(rpm -E %rhel).noarch.rpm"
sudo dnf config-manager --set-enabled crb 2>/dev/null || true

# gh ships from GitHub's own repo here; Fedora carries it in the main repos.
# dnf5 (RHEL 10) renamed the subcommand, so try both spellings.
sudo dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo 2>/dev/null || \
  sudo dnf config-manager addrepo --overwrite --from-repofile=https://cli.github.com/packages/rpm/gh-cli.repo

{{ end -}}
sudo dnf install -y \
{{- range .packages.core }}
  {{ index $.packages.dnf_names . | default . }} \
{{- end }}
  ;

{{ if and (eq .role "desktop") .packages.desktop.linux.dnf }}
sudo dnf install -y \
{{- range .packages.desktop.linux.dnf }}
  {{ . }} \
{{- end }}
  ;
{{ end }}
{{- end }}
