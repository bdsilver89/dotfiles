{
    // =========================================================================
    // Editor
    // =========================================================================

    "editor.fontLigatures": true,
    "editor.fontSize": 12,
    "editor.lineHeight": 1.5,
    "editor.lineNumbers": "relative",

    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "selection",
    "editor.rulers": [100],
    "editor.scrollBeyondLastLine": false,

    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,

    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": true,

    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },

    "editor.stickyScroll.enabled": true,
    "editor.inlayHints.enabled": "on",

    // =========================================================================
    // Files
    // =========================================================================

    "files.autoSave": "off",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // =========================================================================
    // Explorer
    // =========================================================================

    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": false,

    // =========================================================================
    // Search
    // =========================================================================

    "search.useIgnoreFiles": true,
    "search.useGlobalIgnoreFiles": true,
    "search.useSmartCase": true,

    // =========================================================================
    // Workbench
    // =========================================================================

    "workbench.startupEditor": "none",
    "workbench.colorTheme": "GitHub Dark Default",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,

    "workbench.editor.showTabs": "multiple",
    "workbench.editor.highlightModifiedTabs": true,

    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",

    // =========================================================================
    // Breadcrumbs
    // =========================================================================

    "breadcrumbs.enabled": true,

    // =========================================================================
    // Terminal
    // =========================================================================

    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 10000,

    "terminal.integrated.enablePersistentSessions": true,

    // =========================================================================
    // Git
    // =========================================================================

    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,

    // =========================================================================
    // Diff
    // =========================================================================

    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,

    // =========================================================================
    // Remote/WSL/SSH/Containers
    // =========================================================================

    "remote.autoForwardPorts": false,

    // =========================================================================
    // EditorConfig
    // =========================================================================

    "editorconfig.generateAuto": false,

    // =========================================================================
    // YAML
    // =========================================================================

    "yaml.validate": true,
    "yaml.hover": true,
    "yaml.completion": true,

    // =========================================================================
    // Spell Checker
    // =========================================================================

    "cSpell.enabled": true,
    "cSpell.language": "en,en-US",

    // =========================================================================
    // Better Comments
    // =========================================================================

    "better-comments.multilineComments": true,
    "better-comments.highlightPlainText": false,

    // =========================================================================
    // Project Manager
    // =========================================================================

    "projectManager.git.baseFolders": [
        "~/dev/projects",
        "~/Developer/projects"
    ],

    "projectManager.git.maxDepthRecursion": 4,

    // =========================================================================
    // VSCodeVim
    // =========================================================================

    "vim.leader": "<space>",

    "vim.useCtrlKeys": true,
    "vim.useSystemClipboard": true,

    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.ignorecase": true,
    "vim.smartcase": true,
    "vim.showcmd": true,
    "vim.showmodename": true,
    "vim.foldfix": true,
    "vim.surround": true,
    "vim.visualstar": true,
    "vim.highlightedyank.enable": true,

    "vim.easymotion": false,
    "vim.sneak": false,

    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "q"],
            "commands": ["workbench.action.closeActiveEditor"]
        },
        {
            "before": ["<leader>", "w"],
            "commands": ["workbench.action.files.save"]
        },

        {
            "before": ["<C-h>"],
            "commands": ["workbench.action.focusLeftGroup"]
        },
        {
            "before": ["<C-j>"],
            "commands": ["workbench.action.focusBelowGroup"]
        },
        {
            "before": ["<C-k>"],
            "commands": ["workbench.action.focusAboveGroup"]
        },
        {
            "before": ["<C-l>"],
            "commands": ["workbench.action.focusRightGroup"]
        },

        {
            "before": ["[", "b"],
            "commands": ["workbench.action.previousEditor"]
        },
        {
            "before": ["]", "b"],
            "commands": ["workbench.action.nextEditor"]
        },

        {
            "before": ["<leader>", "b", "b"],
            "commands": ["workbench.action.showAllEditors"]
        },
        {
            "before": ["<leader>", "b", "d"],
            "commands": ["workbench.action.closeActiveEditor"]
        },

        {
            "before": ["<leader>", "f", "f"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "f", "r"],
            "commands": ["workbench.action.openRecent"]
        },
        {
            "before": ["<leader>", "f", "g"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "f", "b"],
            "commands": ["workbench.action.showAllEditors"]
        },

        {
            "before": ["<leader>", "e"],
            "commands": ["workbench.view.explorer"]
        },

        {
            "before": ["<leader>", "s", "g"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "s", "s"],
            "commands": ["workbench.action.gotoSymbol"]
        },

        {
            "before": ["<leader>", "p", "p"],
            "commands": ["projectManager.listProjects"]
        },

        {
            "before": ["<leader>", "c", "a"],
            "commands": ["editor.action.quickFix"]
        },
        {
            "before": ["<leader>", "c", "r"],
            "commands": ["editor.action.rename"]
        },
        {
            "before": ["<leader>", "c", "f"],
            "commands": ["editor.action.formatDocument"]
        },

        {
            "before": ["]", "d"],
            "commands": ["editor.action.marker.next"]
        },
        {
            "before": ["[", "d"],
            "commands": ["editor.action.marker.prev"]
        },
        {
            "before": ["<leader>", "x", "x"],
            "commands": ["workbench.actions.view.problems"]
        },

        {
            "before": ["]", "c"],
            "commands": ["workbench.action.editor.nextChange"]
        },
        {
            "before": ["[", "c"],
            "commands": ["workbench.action.editor.prevChange"]
        },

        {
            "before": ["g", "d"],
            "commands": ["editor.action.revealDefinition"]
        },
        {
            "before": ["g", "D"],
            "commands": ["editor.action.revealDeclaration"]
        },
        {
            "before": ["g", "r"],
            "commands": ["editor.action.goToReferences"]
        },
        {
            "before": ["g", "I"],
            "commands": ["editor.action.goToImplementation"]
        },
        {
            "before": ["g", "y"],
            "commands": ["editor.action.goToTypeDefinition"]
        },
        {
            "before": ["K"],
            "commands": ["editor.action.showHover"]
        },

        {
            "before": ["<C-d>"],
            "commands": [
                {
                    "command": "editorScroll",
                    "args": {"to": "down", "by": "wrappedLine", "value": 10}
                }
            ]
        },
        {
            "before": ["<C-u>"],
            "commands": [
                {
                    "command": "editorScroll",
                    "args": {"to": "up", "by": "wrappedLine", "value": 10}
                }
            ]
        },

        {
            "before": ["<leader>", "f", "t"],
            "commands": ["workbench.action.terminal.toggleTerminal"]
        },

        {
            "before": ["<leader>", "g", "g"],
            "commands": ["workbench.view.scm"]
        },

        {
            "before": ["<leader>", "u", "z"],
            "commands": ["workbench.action.toggleZenMode"]
        }
    ],

    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<"],
            "after": ["<", "g", "v"]
        },
        {
            "before": [">"],
            "after": [">", "g", "v"]
        },

        {
            "before": ["<C-h>"],
            "commands": ["workbench.action.focusLeftGroup"]
        },
        {
            "before": ["<C-j>"],
            "commands": ["workbench.action.focusBelowGroup"]
        },
        {
            "before": ["<C-k>"],
            "commands": ["workbench.action.focusAboveGroup"]
        },
        {
            "before": ["<C-l>"],
            "commands": ["workbench.action.focusRightGroup"]
        },

        {
            "before": ["<leader>", "c", "a"],
            "commands": ["editor.action.quickFix"]
        },

        {
            "before": ["<leader>", "c", "f"],
            "commands": ["editor.action.formatSelection"]
        }
    ]
}
