{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
set -eu

COMPDIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions"
mkdir -p "$COMPDIR"
# `x && y` as the last statement would exit 1 when x is false, and chezmoi
# treats a non-zero script as a failed apply.
if command -v workmux >/dev/null 2>&1; then
    workmux completions zsh > "$COMPDIR/_workmux"
fi
{{- end }}
