{{- $role := promptStringOnce . "role" "Machine role (desktop/headless)" "desktop" -}}
{{- $work := promptBoolOnce . "work" "Is this a work machine?" false -}}
{{- $email := promptStringOnce . "email" "Git email" "github@briansilver.net" -}}
{{- /*
  NOTE: `chezmoi init --promptString` is keyed by the PROMPT TEXT below, not by
  the data key. bootstrap.sh, bootstrap.ps1 and .github/workflows/ci.yml all
  pass these exact strings; changing one means changing all four. Kept short for
  that reason — the scheme list lives in themes.yaml and is printed by `theme`
  with no args.
*/ -}}
{{- $theme := promptStringOnce . "theme" "Colour scheme" "onedark" -}}
{{- /*
  role is free text and fails silently when mistyped — "Desktop" or "server"
  just selects every headless branch in .chezmoiignore, with no error anywhere.
  Reject it here, while the offending value is still on screen.

  The matching check for theme lives in .chezmoiignore instead: .chezmoidata is
  not loaded yet at config-render time, so `.themes` is undefined in this file.
*/ -}}
{{- if not (has $role (list "desktop" "headless")) -}}
{{-   fail (printf "role must be \"desktop\" or \"headless\", got %q" $role) -}}
{{- end -}}

# No `encryption` key: the only accepted values are age and gpg, and the empty
# default already means "no encryption". Setting it to "none" is a hard error —
# which stayed hidden for as long as the key sat below [data], where it parsed
# as an inert data.encryption rather than as the option it looked like.

[data]
    role = {{ $role | quote }}
    work = {{ $work }}
    email = {{ $email | quote }}
    theme = {{ $theme | quote }}

[edit]
    command = "nvim"

{{- if eq .chezmoi.os "windows" }}
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{- end }}
