{{- $role := promptStringOnce . "role" "Machine role (desktop/headless)" "desktop" -}}
{{- $work := promptBoolOnce . "work" "Is this a work machine?" false -}}
{{- $email := promptStringOnce . "email" "Git email" "github@briansilver.net" -}}
{{- /*
  NOTE: `chezmoi init --promptString` is keyed by the PROMPT TEXT below, not by
  the data key. bootstrap.sh, bootstrap.ps1 and .github/workflows/ci.yml all
  pass these exact strings; changing one means changing all four. Kept short for
  that reason — the scheme list lives in themes.yaml and is printed by `theme`
  with no args.
*/ -}}
{{- $theme := promptStringOnce . "theme" "Colour scheme" "onedark" -}}

# Above [data]: a bare key after a table header belongs to that table, so
# putting this below would set data.encryption and leave the real option unset.
encryption = "none"

[data]
    role = {{ $role | quote }}
    work = {{ $work }}
    email = {{ $email | quote }}
    theme = {{ $theme | quote }}

[edit]
    command = "nvim"

{{- if eq .chezmoi.os "windows" }}
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{- end }}
