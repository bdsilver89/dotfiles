{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
set -eu

# extensions: {{ .packages.gh_extensions | join " " }}
command -v gh >/dev/null 2>&1 || exit 0

# Public repos need no auth, but this does need the network and it is the one
# install step that fails noisily behind a corporate proxy. Never abort the
# apply over it.
installed="$(gh extension list 2>/dev/null || true)"
{{- range .packages.gh_extensions }}
case "$installed" in
    *{{ . }}*) ;;
    *) gh extension install {{ . }} || echo "gh: {{ . }} install failed" >&2 ;;
esac
{{- end }}
{{- end }}
