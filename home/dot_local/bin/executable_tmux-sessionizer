#!/usr/bin/env bash
set -euo pipefail

projects_dir() {
        if [ -d "$HOME/Developer/projects" ]; then
                printf '%s' "$HOME/Developer/projects"
        else
                printf '%s' "$HOME/dev/projects"
        fi
}

sanitize() {
        printf '%s' "$1" | tr './: ' '----'
}

container() {
        local common
        common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
        [ -n "$common" ] || return 1
        case "${common##*/}" in
        .bare | .git) printf '%s' "${common%/*}" ;;
        *) printf '%s' "$common" ;;
        esac
}

repos() {
        find "$(projects_dir)" -mindepth 2 -maxdepth 3 \
                \( -name node_modules -o -name target -o -name vendor \) -prune -o \
                \( -name .git -o -name .bare \) -print -prune 2>/dev/null |
                while IFS= read -r marker; do
                        container "${marker%/*}" && echo
                done | awk 'NF && !seen[$0]++'
}

attach() {
        local sess="$1" path="${2:-}"
        [ -n "$path" ] && ! tmux has-session -t "=$sess" 2>/dev/null &&
                tmux new-session -d -s "$sess" -c "$path"
        if [ -z "${TMUX:-}" ]; then
                tmux attach -t "=$sess"
        else
                tmux switch-client -t "=$sess"
        fi
}

worktrees() {
        git -C "$1" worktree list --porcelain 2>/dev/null | awk '
                /^worktree /  { p = substr($0, 10); next }
                /^bare$/      { p = ""; next }
                /^branch /    { if (p != "") { b = substr($0, 8); sub(/^refs\/heads\//, "", b); print p "\t" b }; p = ""; next }
                /^detached$/  { if (p != "") print p "\t(detached)"; p = ""; next }
        '
}

plain_dirs() {
        local d child skip
        for d in "$(projects_dir)"/*/; do
                d="${d%/}"
                [ -d "$d" ] || continue
                if [ -e "$d/.git" ] || [ -d "$d/.bare" ]; then continue; fi
                case "$d" in *.worktrees) continue ;; esac
                skip=false
                for child in "$d"/*/; do
                        if [ -e "${child%/}/.git" ]; then skip=true; break; fi
                done
                [ "$skip" = true ] && continue
                printf '%s\n' "$d"
        done
}

menu=""

add_entry() {
        local sess
        sess=$(sanitize "$1")
        tmux has-session -t "=$sess" 2>/dev/null && return 0
        menu+="[new] $3"$'\t'"${sess}"$'\t'"$2"$'\t'"new"$'\n'
}

if tmux ls &>/dev/null; then
        while IFS= read -r sess; do
                [ -n "$sess" ] || continue
                menu+="[switch] ${sess}"$'\t'"${sess}"$'\t'"$HOME"$'\t'"switch"$'\n'
        done < <(tmux list-sessions -F '#{session_name}')
fi

while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        name="${repo##*/}"
        wts=$(worktrees "$repo")
        if [ "$(printf '%s' "$wts" | grep -c . || true)" -le 1 ]; then
                path=$(printf '%s' "$wts" | cut -f1)
                add_entry "$name" "${path:-$repo}" "$name"
        else
                while IFS=$'\t' read -r path branch; do
                        [ -n "$path" ] || continue
                        add_entry "${name}(${branch})" "$path" "${name} (${branch})"
                done < <(printf '%s\n' "$wts")
        fi
done < <(repos)

while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        add_entry "${dir##*/}" "$dir" "${dir##*/}"
done < <(plain_dirs)

[ -z "$menu" ] && exit 0

if command -v eza >/dev/null 2>&1; then
        preview='eza --color=always --icons=always --git -la {3}'
else
        preview='ls -la {3}'
fi

selection=$(printf '%s' "$menu" | LC_ALL=C sort -t$'\t' -k4,4r -k1,1 | fzf --height 100% --delimiter=$'\t' --with-nth=1 --preview "$preview")
[ -z "$selection" ] && exit 0

sess=$(printf '%s' "$selection" | cut -f2)
path=$(printf '%s' "$selection" | cut -f3)
type=$(printf '%s' "$selection" | cut -f4)

if [ "$type" = "new" ]; then
        attach "$sess" "$path"
else
        attach "$sess"
fi
