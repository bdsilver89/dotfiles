#!/usr/bin/env bash
# Fuzzy-find a project directory (or an open workspace) and switch herdr to it.
# Shares tmux-sessionizer's config: TS_SEARCH_PATHS / TS_EXTRA_SEARCH_PATHS / TS_MAX_DEPTH.
set -eo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer/tmux-sessionizer.conf"
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

sanity_check() {
    for cmd in herdr fzf jq; do
        if ! command -v "$cmd" &>/dev/null; then
            echo "$cmd is not installed. Please install it first." >&2
            exit 1
        fi
    done
}

[[ -n "$TS_SEARCH_PATHS" ]] || TS_SEARCH_PATHS=(~/ ~/personal ~/personal/dev/env/.config)

if [[ ${#TS_EXTRA_SEARCH_PATHS[@]} -gt 0 ]]; then
    TS_SEARCH_PATHS+=("${TS_EXTRA_SEARCH_PATHS[@]}")
fi

find_dirs() {
    for entry in "${TS_SEARCH_PATHS[@]}"; do
        if [[ "$entry" =~ ^([^:]+):([0-9]+)$ ]]; then
            path="${BASH_REMATCH[1]}"
            depth="${BASH_REMATCH[2]}"
        else
            path="$entry"
            depth=""
        fi

        [[ -d "$path" ]] && find "$path" -mindepth 1 -maxdepth "${depth:-${TS_MAX_DEPTH:-1}}" -path '*/.git' -prune -o -type d -print
    done
}

list_workspaces() {
    [[ -n "$workspaces" ]] || return 0
    jq -r '.result.workspaces[] | select(.focused | not) | "[HERDR] " + .label' <<<"$workspaces"
}

workspace_id() {
    [[ -n "$workspaces" ]] || return 0
    jq -r --arg label "$1" \
        'first(.result.workspaces[] | select(.label == $label) | .workspace_id) // empty' <<<"$workspaces"
}

sanity_check

workspaces=$(herdr workspace list 2>/dev/null) || workspaces=""

if [[ -n "$1" ]]; then
    selected="$1"
else
    selected=$( { list_workspaces; find_dirs; } | fzf )
fi

[[ -n "$selected" ]] || exit 0

if [[ "$selected" =~ ^\[HERDR\]\ (.+)$ ]]; then
    herdr workspace focus "$(workspace_id "${BASH_REMATCH[1]}")" >/dev/null
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
existing=$(workspace_id "$selected_name")

if [[ -n "$existing" ]]; then
    herdr workspace focus "$existing" >/dev/null
else
    herdr workspace create --cwd "$selected" --label "$selected_name" --focus >/dev/null
fi
