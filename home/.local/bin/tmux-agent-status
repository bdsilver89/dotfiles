#!/usr/bin/env bash
set -euo pipefail

status="${1:?usage: tmux-agent-status <working|waiting|done> <tool>}"
tool="${2:?usage: tmux-agent-status <working|waiting|done> <tool>}"

[ -n "${TMUX_PANE:-}" ] || exit 0

tmux set-option -p -t "$TMUX_PANE" @agent_status "$status"
tmux set-option -p -t "$TMUX_PANE" @agent_tool "$tool"
